{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ihatebills",
  "version": "../package.json",
  "identifier": "com.ihatebills.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ihatebills",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; object-src 'none'; connect-src 'self' ipc: http://ipc.localhost blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3M0E0NEZCMUNBQ0I1ODAKUldTQXRhd2MrMFE2Tit5QUM2UlJVaEcxTkhGQitKQ0JPcWlpNktQZnVKQmNTalJIaFpXczU4cmwK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
